{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "promise",
    "jsdoc"
  ],
  "env": { "builtin": true, "es2026": true },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "out/**",
    ".tmp/**",
    "coverage/**"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error",
    "denyWarnings": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "restriction": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    "max-lines": [
      "error",
      { "max": 150, "skipBlankLines": true, "skipComments": true }
    ],
    "max-lines-per-function": [
      "error",
      { "max": 40, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ],
    "max-statements": ["error", { "max": 12 }],
    "max-params": ["error", { "max": 3, "countThis": "always" }],
    "max-depth": ["error", { "max": 2 }],
    "max-nested-callbacks": ["error", { "max": 2 }],
    "complexity": ["error", { "max": 8, "variant": "modified" }],
    "max-classes-per-file": ["error", 1],
    "id-length": ["error", { "min": 2, "exceptions": ["_"] }],

    "eqeqeq": ["error", "always", { "null": "never" }],
    "curly": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-nested-ternary": "error",
    "no-unneeded-ternary": "error",
    "no-else-return": ["error", { "allowElseIf": false }],
    "no-lonely-if": "error",
    "default-case": "error",
    "default-case-last": "error",
    "no-fallthrough": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-with": "error",
    "no-alert": "error",
    "no-debugger": "error",
    "no-console": "error",
    "no-param-reassign": "error",
    "no-return-assign": "error",
    "no-sequences": "error",
    "no-void": "error",
    "no-useless-return": "error",
    "no-useless-concat": "error",
    "no-useless-rename": "error",
    "no-useless-constructor": "error",
    "object-shorthand": "error",
    "prefer-template": "error",
    "prefer-spread": "error",
    "prefer-rest-params": "error",
    "prefer-arrow-callback": "error",
    "prefer-object-has-own": "error",
    "no-throw-literal": "error",
    "require-await": "error",
    "no-await-in-loop": "error",
    "no-promise-executor-return": "error",
    "no-constructor-return": "error",
    "grouped-accessor-pairs": "error",
    "preserve-caught-error": "error",
    "symbol-description": "error",
    "yoda": ["error", "never"],

    "typescript/ban-ts-comment": ["error", { "minimumDescriptionLength": 10 }],
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports",
        "disallowTypeAnnotations": true
      }
    ],
    "typescript/consistent-type-exports": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "off",
    "typescript/method-signature-style": ["error", "property"],
    "typescript/array-type": ["error", { "default": "array-simple" }],
    "typescript/explicit-function-return-type": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "any": "Do not use `any`. Provide a concrete type.",
          "unknown": "Do not use `unknown`. Narrow to a concrete type.",
          "Function": "Do not use `Function`. Provide an explicit function type.",
          "Object": "Do not use `Object`. Use a specific object type.",
          "Boolean": "Use `boolean` instead of `Boolean`.",
          "Number": "Use `number` instead of `Number`.",
          "String": "Use `string` instead of `String`.",
          "Symbol": "Use `symbol` instead of `Symbol`.",
          "{}": "Do not use `{}`. Use a specific object type or `object`."
        }
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-readonly": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-qualifier": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-var-requires": "error",
    "typescript/no-namespace": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/return-await": ["error", "always"],
    "typescript/promise-function-async": "error",
    "typescript/await-thenable": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-deprecated": "error",

    "oxc/no-barrel-file": "off",
    "unicorn/prefer-ternary": "off",
    "unicorn/no-immediate-mutation": "off",
    "unicorn/no-nested-ternary": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/no-null": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/prefer-module": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/error-message": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/catch-error-name": "error",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/no-process-exit": "error",
    "unicorn/no-anonymous-default-export": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/max-nested-calls": ["error", { "max": 2 }],

    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "eslint/func-style": "off",
    "eslint/no-undefined": "off",
    "eslint/sort-imports": "off",
    "eslint/one-var": "off",
    "eslint/sort-keys": "off",
    "eslint/no-use-before-define": "off",
    "eslint/no-ternary": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/prefer-named-capture-group": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/init-declarations": "off",
    "eslint/no-continue": "off",
    "eslint/arrow-body-style": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/explicit-member-accessibility": "off",
    "node/no-top-level-await": "off",
    "unicorn/no-array-callback-reference": "off",

    "import/no-cycle": ["error", { "maxDepth": 1 }],
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-default-export": "error",
    "import/no-named-as-default": "error",
    "import/no-named-as-default-member": "error",
    "import/no-mutable-exports": "error",
    "import/no-absolute-path": "error",
    "import/no-webpack-loader-syntax": "error",
    "import/no-commonjs": "error",
    "import/no-amd": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-unassigned-import": "error",
    "import/max-dependencies": ["error", { "max": 12 }],
    "import/extensions": [
      "error",
      "ignorePackages",
      { "ts": "always", "js": "always" }
    ],
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],

    "promise/always-return": "error",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/catch-or-return": "error",
    "promise/no-nesting": "error",
    "promise/no-promise-in-callback": "error",
    "promise/no-callback-in-promise": "error",
    "promise/avoid-new": "error",
    "promise/no-new-statics": "error",
    "promise/no-return-in-finally": "error",
    "promise/valid-params": "error",
    "promise/prefer-await-to-then": "error",
    "promise/prefer-await-to-callbacks": "error",

    "node/no-exports-assign": "error",
    "node/no-new-require": "error",
    "node/no-path-concat": "error",
    "node/no-process-env": "error",
    "node/no-sync": "error",
    "node/global-require": "error",

    "jsdoc/check-access": "error",
    "jsdoc/check-property-names": "error",
    "jsdoc/check-tag-names": "error",
    "jsdoc/empty-tags": "error",
    "jsdoc/implements-on-classes": "error",
    "jsdoc/no-defaults": "error",
    "jsdoc/require-param-name": "error",
    "jsdoc/require-property": "error",
    "jsdoc/require-property-name": "error",
    "jsdoc/require-returns-description": "off",
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "jsdoc/require-param-description": "off",
    "jsdoc/require-property-type": "off"
  },
  "overrides": [
    {
      "files": ["bunup.config.ts"],
      "rules": {
        "import/no-default-export": "off",
        "unicorn/no-anonymous-default-export": "off",
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-statements": "off",
        "max-nested-callbacks": ["error", { "max": 4 }],
        "no-console": "off",
        "require-await": "off",
        "unicorn/no-useless-undefined": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/explicit-function-return-type": "off",
        "typescript/no-restricted-types": "off",
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/require-await": "off",
        "typescript/promise-function-async": "off",
        "typescript/return-await": "off"
      }
    }
  ]
}
