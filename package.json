{
  "name": "pagemd",
  "version": "0.0.0",
  "description": "Fetch Markdown for humans and agents",
  "homepage": "https://github.com/AskLunaBot/pagemd",
  "bugs": {
    "url": "https://github.com/AskLunaBot/pagemd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskLunaBot/pagemd.git"
  },
  "bin": {
    "pagemd": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/browser.js",
      "worker": "./dist/browser.js",
      "browser": "./dist/browser.js",
      "deno": "./dist/browser.js",
      "bun": "./dist/index.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bunup",
    "check": "tsc --noEmit && oxlint . && oxfmt --check .",
    "docs": "bun run docs/index.html",
    "fix": "oxlint --fix . && oxfmt .",
    "major": "npm version major --no-git-tag-version",
    "minor": "npm version minor --no-git-tag-version",
    "pagemd": "bun src/cli/cli.ts",
    "patch": "npm version patch --no-git-tag-version",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/turndown": "^5.0.6",
    "bunup": "^0.16.32",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
